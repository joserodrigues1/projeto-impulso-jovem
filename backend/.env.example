NODE_ENV=development
PORT=3333
# URL pública do frontend (CORS, links de e-mail)
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://impulso:impulso@localhost:5432/impulso_jovem?schema=public
REDIS_URL=redis://localhost:6379

# JWT — gere valores longos e aleatórios em produção (ex.: openssl rand -hex 48)
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-pelo-menos-32-caracteres
# Access token curto (minutos) — refresh token é opaco, armazenado como hash no banco
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
# Em produção (HTTPS) use true
COOKIE_SECURE=false

# Criptografia de dados sensíveis (CPF) — 64 caracteres hex (32 bytes)
DATA_ENCRYPTION_KEY=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0
DATA_HASH_KEY=troque-esta-chave-de-hmac-com-pelo-menos-32-caracteres

# Armazenamento de arquivos (MinIO local / S3 / R2)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=impulso-jovem
S3_ACCESS_KEY=impulso
S3_SECRET_KEY=impulso-secret
S3_FORCE_PATH_STYLE=true

# E-mail (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Impulso Jovem <nao-responda@impulsojovem.com.br>"

# Versão vigente do termo de uso/privacidade (LGPD)
LGPD_TERMO_VERSAO=2026.1
