// Schema de dados do Impulso Jovem
// Focado em Letramento Digital e Geração de Currículo via IA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum TipoUsuario {
  USUARIO
  ADMIN
}

enum StatusConta {
  ATIVO
  PENDENTE
  BLOQUEADO
}

// ───────────────────────── Núcleo: usuários ─────────────────────────

model Usuario {
  id               String      @id @default(uuid()) @db.Uuid
  nomeCompleto     String      @map("nome_completo") @db.VarChar(150)
  email            String      @unique @db.VarChar(100)
  senhaHash        String      @map("senha_hash") @db.VarChar(255)
  tipoUsuario      TipoUsuario @default(USUARIO) @map("tipo_usuario")
  statusConta      StatusConta @default(ATIVO) @map("status_conta")
  /// WhatsApp normalizado: 55 + DDD + número, somente dígitos (ex.: 5561999999999).
  /// Chave de integração com a IA recrutadora (n8n).
  telefone         String      @unique @db.VarChar(20)
  fotoUrl          String?     @map("foto_url") @db.VarChar(500)
  ultimoLoginEm    DateTime?   @map("ultimo_login_em")
  criadoEm         DateTime    @default(now()) @map("criado_em")
  atualizadoEm     DateTime    @updatedAt @map("atualizado_em")

  perfil            Perfil?
  curriculosGerados CurriculoGerado[]
  entrevistas       EntrevistaBot[]
  refreshTokens     RefreshToken[]
  tokensRecuperacao TokenRecuperacaoSenha[]
  consentimentos    ConsentimentoLgpd[]
  logsAuditoria     LogAuditoria[]

  @@index([tipoUsuario, statusConta])
  @@map("usuarios")
}

model Perfil {
  id                 String      @id @default(uuid()) @db.Uuid
  usuarioId          String      @unique @map("usuario_id") @db.Uuid
  resumoProfissional String?     @map("resumo_profissional") @db.Text
  nivelEscolaridade  String?     @map("nivel_escolaridade") @db.VarChar(50)
  linkLinkedin       String?     @map("link_linkedin") @db.VarChar(255)
  linkGithub         String?     @map("link_github") @db.VarChar(255)
  habilidades        String[]    @default([])
  cidade             String?     @db.VarChar(100)
  uf                 String?     @db.Char(2)

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  experiencias Experiencia[]

  @@map("perfis")
}

model Experiencia {
  id            String    @id @default(uuid()) @db.Uuid
  perfilId      String    @map("perfil_id") @db.Uuid
  cargo         String    @db.VarChar(150)
  empresa       String    @db.VarChar(150)
  descricao     String?   @db.Text
  dataInicio    DateTime  @map("data_inicio") @db.Date
  dataFim       DateTime? @map("data_fim") @db.Date
  atual         Boolean   @default(false)
  criadoEm      DateTime  @default(now()) @map("criado_em")

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId])
  @@map("experiencias")
}

// ───────────────────────── Geração de Currículo ─────────────────────────

model CurriculoGerado {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  /// Snapshot dos dados do currículo (já refinados pela IA, quando disponível).
  /// O PDF é renderizado sob demanda a partir deste conteúdo.
  conteudo      Json
  refinadoPorIa Boolean  @default(false) @map("refinado_por_ia")
  geradoEm      DateTime @default(now()) @map("gerado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, geradoEm])
  @@map("curriculos_gerados")
}

// ───────────────────────── Simulador de Entrevista (WhatsApp / n8n) ─────────────────────────

/// Feedback gerado pela IA recrutadora ao final de cada simulação no WhatsApp.
model EntrevistaBot {
  id               String   @id @default(uuid()) @db.Uuid
  usuarioId        String   @map("usuario_id") @db.Uuid
  cargoAlvo        String   @map("cargo_alvo") @db.VarChar(150)
  empresaAlvo      String?  @map("empresa_alvo") @db.VarChar(150)
  pontosFortes     String   @map("pontos_fortes") @db.Text
  pontosMelhoria   String   @map("pontos_melhoria") @db.Text
  dicasComunicacao String   @map("dicas_comunicacao") @db.Text
  dataRealizacao   DateTime @default(now()) @map("data_realizacao")
  criadoEm         DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, dataRealizacao])
  @@map("entrevistas_bot")
}

// ───────────────────────── Segurança e LGPD ─────────────────────────

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  /// Família de rotação — reuso detectado revoga toda a família
  familia        String    @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm       DateTime  @map("expira_em")
  revogadoEm     DateTime? @map("revogado_em")
  substituidoPor String?   @map("substituido_por") @db.Uuid
  userAgent      String?   @map("user_agent") @db.VarChar(255)
  ip             String?   @db.VarChar(64)
  criadoEm       DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familia])
  @@map("refresh_tokens")
}

model TokenRecuperacaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens_recuperacao_senha")
}

model ConsentimentoLgpd {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  versaoTermo String   @map("versao_termo") @db.VarChar(20)
  aceitoEm    DateTime @default(now()) @map("aceito_em")
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("consentimentos_lgpd")
}

model LogAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String   @db.VarChar(100)
  entidade   String?  @db.VarChar(60)
  entidadeId String?  @map("entidade_id") @db.VarChar(64)
  detalhes   Json?
  ip         String?  @db.VarChar(64)
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@map("logs_auditoria")
}

model ConfiguracaoSistema {
  chave        String   @id @db.VarChar(80)
  valor        Json
  descricao    String?  @db.VarChar(255)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes_sistema")
}
